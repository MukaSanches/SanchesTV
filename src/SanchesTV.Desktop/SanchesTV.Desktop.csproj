<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SanchesTV</AssemblyName>
    <RootNamespace>SanchesTV.Desktop</RootNamespace>
    <Version>7.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>SanchesTV.Desktop.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SanchesTV.Core\SanchesTV.Core.csproj" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="NAudio" Version="3.1.0" />
    <PackageReference Include="MonoTorrent" Version="3.9.0-alpha.unstable.rev0000" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageReference Include="OpenTelemetry.Api" Version="1.19.0" />
    <PackageReference Include="Polly" Version="8.8.0" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="OpenTelemetry" Version="1.19.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\licenses\MonoTorrent-LICENSE.txt" Link="licenses\MonoTorrent-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

<Window x:Class="SanchesTV.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:playback="clr-namespace:SanchesTV.Desktop.Playback"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SanchesTV 8.2 • Cinema OS Refined"
        Width="1540" Height="920"
        MinWidth="480" MinHeight="320"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="CanResize"
        Background="#0C0E13"
        Foreground="White"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized"
        SizeChanged="Window_SizeChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Fluent title bar -->
        <Border x:Name="TitleBar" Grid.Row="0" Background="#AA0E1117"
                BorderBrush="#24FFFFFF" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Button x:Name="CompactMenuButton"
                            Visibility="Collapsed"
                            Style="{StaticResource CaptionButton}"
                            Content="&#xE700;"
                            ToolTip="Menu"
                            Click="CompactMenu_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Início" Click="Home_Click"/>
                                <MenuItem Header="Ao vivo" Click="All_Click"/>
                                <MenuItem Header="Filmes" Click="Movies_Click"/>
                                <MenuItem Header="Brasil" Click="Brazil_Click"/>
                                <MenuItem Header="Português" Click="Lusophone_Click"/>
                                <MenuItem Header="Premium oficial" Click="Premium_Click"/>
                                <Separator/>
                                <MenuItem Header="Favoritos" Click="Favorites_Click"/>
                                <MenuItem Header="Minha TV" Click="MyTv_Click"/>
                                <MenuItem Header="Recentes" Click="Recent_Click"/>
                                <Separator/>
                                <MenuItem Header="Importar M3U" Click="ImportFile_Click"/>
                                <MenuItem Header="Adicionar URL M3U" Click="ImportUrl_Click"/>
                                <MenuItem Header="Adicionar Xtream" Click="Xtream_Click"/>
                                <MenuItem Header="Importar EPG" Click="ImportEpg_Click"/>
                                <MenuItem Header="Streaming P2P" Click="P2p_Click"/>
                                <MenuItem Header="Media Lab 7" Click="MediaLab_Click"/>
                                <MenuItem Header="Guia / gravações" Click="EpgGuide_Click"/>
                                <MenuItem Header="Atualizar catálogo" Click="SyncPortugueseCatalog_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Grid Width="32" Height="32">
                        <Border Background="{StaticResource BrandGradient}" CornerRadius="10"/>
                        <TextBlock Text="S" FontSize="19" FontWeight="Black"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Path Data="M 0 0 L 7 4 L 0 8 Z" Fill="White"
                              Width="7" Height="8" Stretch="Fill"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Margin="0,0,5,5"/>
                    </Grid>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SanchesTV" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="8.2 • Cinema OS" FontSize="10" Foreground="#8EA0B8"/>
                    </StackPanel>
                </StackPanel>

                <Border x:Name="TitleStatusContainer" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#18FFFFFF" CornerRadius="16" Padding="12,4">
                    <TextBlock x:Name="TitleStatusText" Text="Central de TV em Português"
                               Foreground="#B8C2D2" FontSize="11"/>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE721;" Click="CommandPalette_Click" ToolTip="Command Center • Ctrl+K"/>
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click"/>
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click"/>
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="216"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left navigation -->
            <Border x:Name="NavigationPanel" Grid.Column="0"
                    Background="#A811141B" BorderBrush="#20FFFFFF" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <StackPanel Margin="10,14,10,14">
                        <TextBlock Text="NAVEGAR" Foreground="#6F7C90" FontSize="10"
                                   FontWeight="SemiBold" Margin="14,0,0,8"/>
                        <Button Style="{StaticResource NavButton}" Click="Home_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE80F;" Width="28" FontSize="16"/>
                                <TextBlock Text="Início"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Click="All_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE714;" Width="28" FontSize="16"/>
                                <TextBlock Text="Ao vivo"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Click="Movies_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B2;" Width="28" FontSize="16"/>
                                <TextBlock Text="Filmes"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Click="Brazil_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE774;" Width="28" FontSize="16"/>
                                <TextBlock Text="Brasil"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Click="Lusophone_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE12B;" Width="28" FontSize="16"/>
                                <TextBlock Text="Português"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Click="Premium_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE734;" Width="28" FontSize="16"/>
                                <TextBlock Text="Premium oficial"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="#20FFFFFF" Margin="12,12"/>

                        <TextBlock Text="BIBLIOTECA" Foreground="#6F7C90" FontSize="10"
                                   FontWeight="SemiBold" Margin="14,0,0,8"/>
                        <Button Style="{StaticResource NavButton}" Click="Favorites_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE735;" Width="28" FontSize="16"/>
                                <TextBlock Text="Favoritos"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Click="MyTv_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7F4;" Width="28" FontSize="16"/>
                                <TextBlock Text="Minha TV"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Click="Recent_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE823;" Width="28" FontSize="16"/>
                                <TextBlock Text="Recentes"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="#20FFFFFF" Margin="12,12"/>

                        <TextBlock Text="FONTES E DADOS" Foreground="#6F7C90" FontSize="10"
                                   FontWeight="SemiBold" Margin="14,0,0,6"/>
                        <UniformGrid Columns="2" Margin="2,0,2,4">
                            <Button Style="{StaticResource ModernButton}" Content="+ M3U"
                                    Click="ImportFile_Click" ToolTip="Importar arquivo M3U/M3U8"/>
                            <Button Style="{StaticResource ModernButton}" Content="+ URL"
                                    Click="ImportUrl_Click" ToolTip="Adicionar playlist M3U por URL"/>
                            <Button Style="{StaticResource ModernButton}" Content="+ Xtream"
                                    Click="Xtream_Click" ToolTip="Adicionar servidor Xtream do usuário"/>
                            <Button Style="{StaticResource ModernButton}" Content="+ EPG"
                                    Click="ImportEpg_Click" ToolTip="Importar guia XMLTV"/>
                        </UniformGrid>
                        <Button Style="{StaticResource ModernButton}" Content="◉ Streaming P2P"
                                Click="P2p_Click" Margin="5,2" ToolTip="Assistir magnet ou .torrent autorizado sem esperar o download completo"/>
                        <Button Style="{StaticResource ModernButton}" Content="◈ Media Lab 8"
                                Click="MediaLab_Click" Margin="5,2" ToolTip="Roteamento, broadcast, diagnóstico, legendas e transcrição local"/>
                        <Button Style="{StaticResource ModernButton}" Content="▤ Guia / gravações"
                                Click="EpgGuide_Click" Margin="5,2" ToolTip="Guia de programação e gravação agendada"/>
                        <Button Style="{StaticResource AccentButton}" Content="↻ Atualizar catálogo"
                                Click="SyncPortugueseCatalog_Click" Margin="5,2"/>
                        <TextBlock x:Name="StatusText" Text="Pronto"
                                   Foreground="#7F8B9F" TextWrapping="Wrap"
                                   FontSize="10" Margin="10,6,10,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1">
                <!-- HOME -->
                <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,26,28,40">
                        <Border Style="{StaticResource CardBorder}" Background="{StaticResource HeroGradient}"
                                MinHeight="260" Padding="34">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="360"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" MaxWidth="700">
                                    <Border Background="#26FFFFFF" CornerRadius="12" Padding="10,5"
                                            HorizontalAlignment="Left" Margin="0,0,0,14">
                                        <TextBlock Text="SANCHES TV 8.2 • CINEMA OS" FontSize="10"
                                                   FontWeight="Bold" Foreground="#D8E6FF"/>
                                    </Border>
                                    <TextBlock Text="Sua TV evoluiu para uma plataforma de mídia inteligente."
                                               FontSize="38" FontWeight="Bold" TextWrapping="Wrap"
                                               LineHeight="44"/>
                                    <TextBlock Text="Playback inteligente, P2P, timeshift, gravação e ferramentas profissionais em uma experiência mais rápida, resiliente e cinematográfica."
                                               FontSize="15" Foreground="#C8D0DE" TextWrapping="Wrap"
                                               Margin="0,14,0,20" MaxWidth="650"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource AccentButton}" Content="▶ Explorar ao vivo"
                                                Click="All_Click" Padding="18,11"/>
                                        <Button Style="{StaticResource ModernButton}" Content="🎬 Ver filmes"
                                                Click="Movies_Click" Padding="18,11"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Grid.Column="1" Margin="28,8,0,8">
                                    <Border Background="#28000000" CornerRadius="26" BorderBrush="#32FFFFFF"
                                            BorderThickness="1" Padding="26">
                                        <StackPanel VerticalAlignment="Center">
                                            <Grid Width="110" Height="110" HorizontalAlignment="Center">
                                                <Ellipse Fill="{StaticResource BrandGradient}"/>
                                                <TextBlock Text="S" FontSize="62" FontWeight="Black"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Path Data="M 0 0 L 19 11 L 0 22 Z" Fill="White"
                                                      Width="19" Height="22" Stretch="Fill"
                                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                      Margin="0,0,8,10"/>
                                            </Grid>
                                            <TextBlock x:Name="HomeCountText" Text="Carregando catálogo..."
                                                       FontWeight="SemiBold" FontSize="16"
                                                       HorizontalAlignment="Center" Margin="0,18,0,4"/>
                                            <TextBlock Text="Atualização automática • failover • miniaturas"
                                                       Foreground="#A8B4C7" FontSize="11"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Margin="0,30,0,12">
                            <TextBlock Text="Continuar assistindo" FontSize="22" FontWeight="SemiBold"/>
                            <Button HorizontalAlignment="Right" Style="{StaticResource ModernButton}"
                                    Content="Ver recentes" Click="Recent_Click"/>
                        </Grid>
                        <ListBox x:Name="RecentHomeList" Height="154" Background="Transparent"
                                 BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="HomeList_MouseDoubleClick">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="214" Height="138" Margin="0,0,12,0"
                                            Style="{StaticResource CardBorder}">
                                        <Grid>
                                            <Border Margin="12" Background="#28FFFFFF" CornerRadius="12">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initial}" FontSize="30" FontWeight="Bold"
                                                               Foreground="#668B5CF6"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding Logo, IsAsync=True}" Stretch="Uniform"
                                                           Margin="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Grid>
                                            </Border>
                                            <Border Background="#B8000000" VerticalAlignment="Bottom"
                                                    CornerRadius="0,0,16,16" Padding="12,8">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Margin="0,28,0,12">
                            <TextBlock Text="Brasil em destaque" FontSize="22" FontWeight="SemiBold"/>
                            <Button HorizontalAlignment="Right" Style="{StaticResource ModernButton}"
                                    Content="Ver Brasil" Click="Brazil_Click"/>
                        </Grid>
                        <ListBox x:Name="BrazilHomeList" Height="154" Background="Transparent"
                                 BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="HomeList_MouseDoubleClick">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="214" Height="138" Margin="0,0,12,0"
                                            Style="{StaticResource CardBorder}">
                                        <Grid>
                                            <Border Margin="12" Background="#24FFFFFF" CornerRadius="12">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initial}" FontSize="30" FontWeight="Bold"
                                                               Foreground="#6616D9E3"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding Logo, IsAsync=True}" Stretch="Uniform"
                                                           Margin="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Grid>
                                            </Border>
                                            <Border Background="#B8000000" VerticalAlignment="Bottom"
                                                    CornerRadius="0,0,16,16" Padding="12,8">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Margin="0,28,0,12">
                            <TextBlock Text="Filmes" FontSize="22" FontWeight="SemiBold"/>
                            <Button HorizontalAlignment="Right" Style="{StaticResource ModernButton}"
                                    Content="Abrir catálogo de filmes" Click="Movies_Click"/>
                        </Grid>
                        <ListBox x:Name="MoviesHomeList" Height="154" Background="Transparent"
                                 BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="HomeList_MouseDoubleClick">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="214" Height="138" Margin="0,0,12,0"
                                            Style="{StaticResource CardBorder}">
                                        <Grid>
                                            <Border Margin="12" Background="#24FFFFFF" CornerRadius="12">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initial}" FontSize="30" FontWeight="Bold"
                                                               Foreground="#668B5CF6"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding Logo, IsAsync=True}" Stretch="Uniform"
                                                           Margin="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Grid>
                                            </Border>
                                            <Border Background="#B8000000" VerticalAlignment="Bottom"
                                                    CornerRadius="0,0,16,16" Padding="12,8">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- BROWSE + PLAYER -->
                <Grid x:Name="BrowseView" Visibility="Collapsed" Margin="24,20,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="BrowseHeader" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="SearchColumn" Width="330"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CompactChannelButton"
                                    Visibility="Collapsed"
                                    Style="{StaticResource ModernButton}"
                                    Content="☰ Canais"
                                    Margin="0,0,10,0"
                                    Click="ToggleCompactPane_Click"
                                    ToolTip="Alternar entre lista de canais e player"/>
                            <StackPanel>
                                <TextBlock x:Name="BrowseTitleText" Text="Ao vivo"
                                           FontSize="30" FontWeight="Bold"/>
                                <TextBlock x:Name="BrowseSubtitleText"
                                           Text="Escolha um canal e comece a assistir."
                                           Foreground="#8F9BAD" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Height="42"
                                Background="#14181F28"
                                BorderBrush="#32FFFFFF"
                                BorderThickness="1"
                                CornerRadius="12">
                            <Grid>
                                <TextBlock FontFamily="Segoe Fluent Icons"
                                           Text="&#xE721;"
                                           Foreground="#8FA1B8"
                                           FontSize="14"
                                           Margin="13,0,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                <TextBox x:Name="SearchBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="36,10,12,10"
                                         Height="42"
                                         TextChanged="SearchBox_TextChanged"
                                         ToolTip="Buscar canal, categoria, país, estado ou região"/>
                                <TextBlock Text="Buscar canais, esportes, filmes..."
                                           Foreground="#728096"
                                           Margin="38,0,10,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="BrowseContentGrid" Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ChannelBrowserColumn" Width="390"/>
                            <ColumnDefinition x:Name="BrowseGapColumn" Width="14"/>
                            <ColumnDefinition x:Name="PlayerColumn" Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="ChannelBrowserPanel" Grid.Column="0" Style="{StaticResource CardBorder}" Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ListBox x:Name="ChannelList"
                                         Background="Transparent" Foreground="White"
                                         BorderThickness="0"
                                         ScrollViewer.CanContentScroll="True"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         MouseDoubleClick="ChannelList_MouseDoubleClick"
                                         SelectionChanged="ChannelList_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,2"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="RowBg" CornerRadius="11"
                                                                Background="{TemplateBinding Background}"
                                                                Padding="8">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="RowBg" Property="Background" Value="#1FFFFFFF"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="RowBg" Property="Background" Value="#338B5CF6"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="70">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="74"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="62" Height="54" CornerRadius="10"
                                                        Background="#22FFFFFF" VerticalAlignment="Center">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Initial}" FontSize="18" FontWeight="Bold"
                                                                   Foreground="#667C8CA4"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image Source="{Binding Logo, IsAsync=True}" Stretch="Uniform"
                                                               Margin="8" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Details}" Foreground="#8290A5"
                                                               FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding SourceInfo}" Foreground="#667489"
                                                               FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding FavoriteMark}"
                                                           Foreground="#F7C948" FontSize="17"
                                                           VerticalAlignment="Center" Margin="8"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Grid.Row="1" BorderBrush="#20FFFFFF" BorderThickness="0,1,0,0"
                                        Padding="6,8,6,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="CountText"
                                                   Foreground="#8B96A8"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="2,0,8,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Style="{StaticResource ModernButton}" Content="★"
                                                    ToolTip="Favorito" Click="ToggleFavorite_Click"/>
                                            <Button Style="{StaticResource ModernButton}" Content="+ TV"
                                                    ToolTip="Adicionar/remover da Minha TV" Click="ToggleMyTv_Click"/>
                                            <Button Style="{StaticResource ModernButton}" Content="✓"
                                                    ToolTip="Testar fontes" Click="HealthCheck_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border x:Name="PlayerPanel" Grid.Column="2" Style="{StaticResource CardBorder}" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Background="Black">
                                    <playback:MpvHost x:Name="MpvSurface"/>
                                    <vlc:VideoView x:Name="VideoView" Background="Black" Visibility="Collapsed"/>
                                    <Border x:Name="VideoDoubleClickSurface"
                                            Background="#01000000"
                                            MouseLeftButtonDown="VideoSurface_MouseLeftButtonDown"
                                            ToolTip="Duplo clique para tela cheia"/>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <Border x:Name="PlayerInfoBar"
                                            Background="#F014171D"
                                            BorderBrush="#20FFFFFF"
                                            BorderThickness="0,1,0,0"
                                            Padding="14,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#24FF405A"
                                                    BorderBrush="#44FF405A"
                                                    BorderThickness="1"
                                                    CornerRadius="9"
                                                    Padding="9,5"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="#FF405A" Margin="0,0,6,0"/>
                                                    <TextBlock Text="AO VIVO" FontWeight="Bold" FontSize="10"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Width="46" Height="46"
                                                    Background="#1FFFFFFF"
                                                    CornerRadius="10"
                                                    Margin="0,0,10,0">
                                                <Grid>
                                                    <TextBlock x:Name="PlayerInitialText" Text="S"
                                                               FontSize="17" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="#7C8DA5"/>
                                                    <Image x:Name="PlayerLogo" Stretch="Uniform" Margin="7"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock x:Name="NowPlayingText" Text="Selecione um canal"
                                                           FontSize="16" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="NowEpgText"
                                                           Foreground="#C4CCD8"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="NextEpgText"
                                                           Foreground="#78869A"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Border Grid.Column="3"
                                                    Background="#20FFFFFF"
                                                    BorderBrush="#24FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="9"
                                                    Padding="10,6"
                                                    VerticalAlignment="Center"
                                                    MaxWidth="210">
                                                <TextBlock x:Name="SourceBadgeText" Text="PRONTO"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="#B7C5D9"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="LoadingOverlay"
                                            Background="#FA14171D"
                                            Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Margin="16,12">
                                            <ProgressBar IsIndeterminate="True"
                                                         Width="120"
                                                         Height="4"
                                                         Margin="0,0,12,0"/>
                                            <TextBlock x:Name="LoadingText"
                                                       Text="Carregando..."
                                                       VerticalAlignment="Center"
                                                       Foreground="#C7D0DD"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border x:Name="PlayerCommandBar" Grid.Row="2"
                                        Background="#F0161A22" Padding="7"
                                        BorderBrush="#20FFFFFF" BorderThickness="0,1,0,0">
                                    <StackPanel>
                                        <WrapPanel x:Name="PlayerPrimaryCommands" HorizontalAlignment="Left">
                                            <Button Style="{StaticResource ModernButton}" Content="⏮" MinWidth="40"
                                                    ToolTip="Canal anterior" Click="Previous_Click"/>
                                            <Button x:Name="PlayPauseButton" Style="{StaticResource AccentButton}" Content="⏯"
                                                    MinWidth="46" ToolTip="Reproduzir/Pausar" Click="PlayPause_Click"/>
                                            <Button Style="{StaticResource ModernButton}" Content="⏭" MinWidth="40"
                                                    ToolTip="Próximo canal" Click="Next_Click"/>
                                            <Button Style="{StaticResource ModernButton}" Content="⏹" MinWidth="40"
                                                    ToolTip="Parar" Click="Stop_Click"/>
                                            <Button x:Name="MuteButton" Style="{StaticResource ModernButton}" Content="🔊" MinWidth="40"
                                                    ToolTip="Mudo" Click="Mute_Click"/>
                                            <Border Background="#18FFFFFF" CornerRadius="9"
                                                    Margin="3" Padding="8,4" MinWidth="140">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Vol." Foreground="#9AA6B8"
                                                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100"
                                                            Value="80" Width="95" VerticalAlignment="Center"
                                                            ToolTip="Volume"
                                                            ValueChanged="VolumeSlider_ValueChanged"/>
                                                </StackPanel>
                                            </Border>
                                            <Button x:Name="FullscreenButton"
                                                    Style="{StaticResource AccentButton}"
                                                    Content="⛶  Tela cheia  F11"
                                                    MinWidth="132"
                                                    Click="Fullscreen_Click"
                                                    ToolTip="Tela cheia — F11 ou duplo clique no vídeo"/>
                                        </WrapPanel>

                                        <WrapPanel x:Name="PlayerSecondaryCommands"
                                                   Margin="0,3,0,0" HorizontalAlignment="Left">
                                            <Button Style="{StaticResource ModernButton}" Content="−30s"
                                                    MinWidth="58" Click="Rewind_Click" ToolTip="Voltar 30 segundos"/>
                                            <Button x:Name="TimeshiftButton" Style="{StaticResource ModernButton}" Content="⏱ Timeshift"
                                                    MinWidth="86" Click="Timeshift_Click" ToolTip="Criar buffer local para pausar e voltar TV ao vivo"/>
                                            <Button Style="{StaticResource ModernButton}" Content="LIVE"
                                                    MinWidth="58" Click="Live_Click" ToolTip="Ir para o ponto ao vivo"/>
                                            <Button x:Name="RecordButton" Style="{StaticResource ModernButton}" Content="● REC"
                                                    MinWidth="68" Click="Record_Click" ToolTip="Gravar quando permitido"/>
                                            <Button Style="{StaticResource ModernButton}" Content="PiP"
                                                    MinWidth="52" Click="Pip_Click" ToolTip="Picture in Picture"/>
                                            <Button Style="{StaticResource ModernButton}" Content="▦  Multiview"
                                                    MinWidth="92" Click="Multiview_Click" ToolTip="Abrir até quatro canais"/>
                                            <Button Style="{StaticResource ModernButton}" Content="📱  Controle"
                                                    MinWidth="92" Click="Remote_Click" ToolTip="Controle remoto pelo celular"/>
                                            <Button Style="{StaticResource ModernButton}" Content="⚙  Áudio/Vídeo"
                                                    MinWidth="104" Click="AudioVideo_Click" ToolTip="HDR, deinterlace, interpolação, áudio e legendas"/>
                                            <Button Style="{StaticResource ModernButton}" Content="▤  Guia"
                                                    MinWidth="70" Click="EpgGuide_Click" ToolTip="Guia de 14 dias e gravações agendadas"/>
                                            <Button Style="{StaticResource ModernButton}" Content="◈  Media Lab"
                                                    MinWidth="92" Click="MediaLab_Click" ToolTip="MediaMTX, TSDuck, FFprobe, CCExtractor e Whisper"/>
                                            <Button Style="{StaticResource ModernButton}" Content="ⓘ  Diagnóstico"
                                                    MinWidth="100" Click="Diagnostics_Click" ToolTip="Informações técnicas"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>
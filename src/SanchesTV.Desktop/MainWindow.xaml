<Window x:Class="SanchesTV.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="SanchesTV 4.0" Width="1440" Height="860"
        MinWidth="1040" MinHeight="650"
        Background="#0E1014" Foreground="White"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="HeaderPanel" Grid.Row="0" Background="#171A20" Padding="12">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <StackPanel Margin="4,0,18,0" VerticalAlignment="Center">
                        <TextBlock Text="SanchesTV" FontSize="25" FontWeight="Bold"/>
                        <TextBlock Text="4.0 • Mega Catálogo PT/BR + Premium" FontSize="10" Foreground="#7FC8FF"/>
                    </StackPanel>
                    <Button Content="Todos" Click="All_Click"/>
                    <Button Content="Brasil" Click="Brazil_Click"/>
                    <Button Content="Portugal/Lusofonia" Click="Lusophone_Click"/>
                    <Button Content="Premium" Click="Premium_Click" ToolTip="Abrir Hub Premium PT-BR"/>
                    <Button Content="Favoritos" Click="Favorites_Click"/>
                    <Button Content="Recentes" Click="Recent_Click"/>
                    <Button Content="Minha TV" Click="MyTv_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="↻ Atualizar 6 fontes PT/BR" Click="SyncPortugueseCatalog_Click" ToolTip="Atualiza o catálogo português a partir de fontes públicas selecionadas no GitHub"/>
                    <Button Content="+ M3U arquivo" Click="ImportFile_Click"/>
                    <Button Content="+ M3U URL" Click="ImportUrl_Click"/>
                    <Button Content="+ Xtream" Click="Xtream_Click"/>
                    <Button Content="+ EPG" Click="ImportEpg_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LibraryColumn" Width="410"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="LibraryPanel" Grid.Column="0" Background="#12151A" Padding="12" BorderBrush="#242A33" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="SearchBox" Height="38" TextChanged="SearchBox_TextChanged" ToolTip="Buscar canal, categoria, país, estado ou região"/>
                    <ListBox x:Name="ChannelList" Grid.Row="1" Margin="0,10,0,8"
                             Background="#12151A" Foreground="White" BorderThickness="0"
                             MouseDoubleClick="ChannelList_MouseDoubleClick"
                             SelectionChanged="ChannelList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,2" Background="#1A1E25" CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="35"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding VirtualNumber}" Foreground="#8E97A6" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Details}" Foreground="#8E97A6" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SourceInfo}" Foreground="#667085" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding FavoriteMark}" Foreground="#F5C451" FontSize="16" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2">
                        <TextBlock x:Name="CountText" Foreground="#9AA3B2" Margin="4,0,0,6"/>
                        <WrapPanel>
                            <Button Content="★ Favorito" Click="ToggleFavorite_Click"/>
                            <Button Content="+ Minha TV" Click="ToggleMyTv_Click"/>
                            <Button Content="Testar fonte" Click="HealthCheck_Click"/>
                            <Button Content="Catálogo base" Click="BuiltIn_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="Black">
                <vlc:VideoView x:Name="VideoView"/>
                <Border Background="#99000000" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18" Padding="12" CornerRadius="8">
                    <StackPanel>
                        <TextBlock x:Name="NowPlayingText" Text="Selecione um canal" FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="NowEpgText" Foreground="#D1D5DB" Margin="0,4,0,0"/>
                        <TextBlock x:Name="NextEpgText" Foreground="#9AA3B2"/>
                    </StackPanel>
                </Border>

                <Border x:Name="LoadingOverlay" Background="#B0000000" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="280" Height="6"/>
                        <TextBlock x:Name="LoadingText" Text="Carregando..." HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border x:Name="FooterPanel" Grid.Row="2" Background="#171A20" Padding="10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="⏮" Width="48" Click="Previous_Click"/>
                    <Button x:Name="PlayPauseButton" Content="⏯" Width="48" Click="PlayPause_Click"/>
                    <Button Content="⏹" Width="48" Click="Stop_Click"/>
                    <Button Content="⏭" Width="48" Click="Next_Click"/>
                    <Button x:Name="MuteButton" Content="🔊" Width="48" Click="Mute_Click"/>
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="80" Width="150" Margin="8,0"
                            ValueChanged="VolumeSlider_ValueChanged"/>
                    <Button Content="−30s" Click="Rewind_Click" ToolTip="Voltar 30 segundos quando a fonte permitir timeshift"/>
                    <Button Content="LIVE" Click="Live_Click" ToolTip="Retornar ao ponto ao vivo quando a fonte permitir"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="RecordButton" Content="● Gravar" Click="Record_Click"/>
                    <Button Content="PiP" Click="Pip_Click"/>
                    <Button Content="Multiview" Click="Multiview_Click"/>
                    <Button Content="📱 Controle" Click="Remote_Click"/>
                    <Button Content="ⓘ Diagnóstico" Click="Diagnostics_Click"/>
                    <Button Content="⛶ Tela cheia" Click="Fullscreen_Click"/>
                </StackPanel>

                <TextBlock x:Name="StatusText" Text="Pronto" VerticalAlignment="Center" Foreground="#AAB2C0" Margin="14,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>

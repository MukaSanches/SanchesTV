<Window x:Class="SanchesTV.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SanchesTV" Height="760" Width="1220"
        MinHeight="600" MinWidth="900"
        Background="#101114" Foreground="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#17191E" Padding="18">
            <StackPanel>
                <TextBlock Text="SanchesTV" FontSize="28" FontWeight="Bold" Margin="0,0,0,28"/>
                <Button Content="Início" Margin="0,4" Padding="12"/>
                <Button Content="Ao vivo" Margin="0,4" Padding="12"/>
                <Button Content="Guia" Margin="0,4" Padding="12"/>
                <Button Content="Favoritos" Margin="0,4" Padding="12"/>
                <Button Content="Minha TV" Margin="0,4" Padding="12"/>
                <Button Content="Fontes" Margin="0,4" Padding="12"/>
                <Button Content="Configurações" Margin="0,4" Padding="12"/>
            </StackPanel>
        </Border>
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,18">
                <TextBlock Text="Central de TV para Windows" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBox x:Name="SearchBox" Width="320" Height="36" Margin="20,0,0,0" HorizontalAlignment="Right" Text="Buscar canais..."/>
            </DockPanel>
            <Border Grid.Row="1" Background="Black" CornerRadius="10">
                <Grid>
                    <TextBlock Text="Selecione ou importe uma fonte legítima para começar"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#BFC3CC" FontSize="18"/>
                </Grid>
            </Border>
            <DockPanel Grid.Row="2" Margin="0,18,0,0">
                <Button Content="⏮" Width="50" Height="38"/>
                <Button Content="▶" Width="50" Height="38" Margin="8,0"/>
                <Button Content="⏭" Width="50" Height="38"/>
                <Slider Minimum="0" Maximum="100" Value="80" Width="180" Margin="18,0"/>
                <TextBlock Text="Pronto" VerticalAlignment="Center" Margin="18,0"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
